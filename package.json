{
  "name": "moodle-quiz-ts",
  "version": "1.0.0",
  "description": "Typed Moodle XML and GIFT question-bank model and converters",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "moodle-quiz": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "format": "prettier --write src tests *.json *.md",
    "format:check": "prettier --check src tests *.json *.md",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.11"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  }
}
